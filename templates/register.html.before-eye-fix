<!DOCTYPE html>

<html
    lang="en"
    data-theme="dark">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1, viewport-fit=cover">

    <meta
        name="theme-color"
        content="#080808">

    <title>
        Create Account · Expense Manager
    </title>

    <link
        rel="stylesheet"
        href="{{ url_for('static', filename='auth.css') }}">

</head>


<body class="auth-page register-page">


    <main class="auth-pro-shell">


        <!-- BRAND -->

        <header class="auth-pro-header">

            <a
                href="/login"
                class="auth-pro-brand">

                <span class="auth-pro-brand-mark">
                    ₹
                </span>

                <span>
                    Expense Manager
                </span>

            </a>

            <span class="auth-pro-secure">
                Secure account
            </span>

        </header>



        <!-- MAIN -->

        <section class="auth-pro-layout">


            <!-- LEFT SIDE -->

            <div class="auth-pro-hero">

                <span class="auth-pro-eyebrow">
                    PERSONAL FINANCE
                </span>

                <h1>
                    Start managing
                    <span>
                        money smarter.
                    </span>
                </h1>

                <p>
                    Track every rupee, understand your spending
                    and take control of your financial life.
                </p>


                <div class="auth-pro-feature-list">

                    <div>

                        <span>01</span>

                        <div>
                            <strong>
                                Track everything
                            </strong>

                            <small>
                                Income, expenses, bills and subscriptions.
                            </small>
                        </div>

                    </div>


                    <div>

                        <span>02</span>

                        <div>
                            <strong>
                                Plan ahead
                            </strong>

                            <small>
                                Budgets, goals and recurring transactions.
                            </small>
                        </div>

                    </div>


                    <div>

                        <span>03</span>

                        <div>
                            <strong>
                                Understand your money
                            </strong>

                            <small>
                                Reports, analytics and financial insights.
                            </small>
                        </div>

                    </div>

                </div>

            </div>



            <!-- REGISTER PANEL -->

            <div class="auth-pro-panel">


                <div class="auth-pro-panel-heading">

                    <span class="auth-pro-eyebrow">
                        GET STARTED
                    </span>

                    <h2>
                        Create your account
                    </h2>

                    <p>
                        Your personal finance workspace starts here.
                    </p>

                </div>


                {% if error %}

                <div
                    class="auth-pro-error"
                    role="alert">

                    {{ error }}

                </div>

                {% endif %}


                <form
                    action="/register"
                    method="POST"
                    class="auth-pro-form">


                    <div class="auth-pro-field">

                        <label for="register-username">
                            Name
                        </label>

                        <input
                            id="register-username"
                            type="text"
                            name="username"
                            placeholder="Enter your name"
                            autocomplete="name"
                            maxlength="80"
                            required>

                    </div>



                    <div class="auth-pro-field">

                        <label for="register-email">
                            Email address
                        </label>

                        <input
                            id="register-email"
                            type="email"
                            name="email"
                            placeholder="name@example.com"
                            autocomplete="email"
                            inputmode="email"
                            required>

                    </div>



                    <div class="auth-pro-field">

                        <label for="register-password">
                            Password
                        </label>

                        <div class="auth-password-wrap">

                            <input
                                id="register-password"
                                type="password"
                                name="password"
                                placeholder="Create a secure password"
                                autocomplete="new-password"
                                minlength="6"
                                required>


<button
    type="button"
    class="auth-password-toggle"
    id="register-password-toggle"
    aria-label="Show password"
    aria-pressed="false">
    Login
</button>


                        </div>

                    </div>



                    <button
                        type="submit"
                        class="auth-pro-submit">

                        Create Account

                        <span>
                            →
                        </span>

                    </button>


                </form>


                <div class="auth-pro-divider">

                    <span>
                        Already have an account?
                    </span>

                </div>


                <a
                    href="/login"
                    class="auth-pro-secondary">

                    Sign in instead

                </a>


                <p class="auth-pro-terms">
                    By creating an account, you agree to use
                    Expense Manager responsibly for your own
                    financial tracking.
                </p>


            </div>


        </section>



        <footer class="auth-pro-footer">

            <span>
                Expense Manager
            </span>

            <span>
                Designed & developed by Harsh Raj
            </span>

        </footer>


    </main>


    <script>
        document
            .querySelectorAll(
                "[data-password-target]"
            )
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        const input =
                            document.getElementById(
                                button.dataset.passwordTarget
                            );

                        if (!input) {
                            return;
                        }

                        const showing =
                            input.type === "text";

                        input.type =
                            showing
                                ? "password"
                                : "text";

                        button.textContent =
                            showing
                                ? "Show"
                                : "Hide";

                        button.setAttribute(
                            "aria-label",
                            showing
                                ? "Show password"
                                : "Hide password"
                        );

                    }
                );

            });
    </script>


    <script
        src="{{ url_for('static', filename='js/offline.js') }}"
        defer>
    </script>



<!-- REGISTER PASSWORD EYE -->
<script>
document.addEventListener(
    "DOMContentLoaded",
    function () {

        const password =
            document.getElementById(
                "register-password"
            );

        const toggle =
            document.getElementById(
                "register-password-toggle"
            );

        if (!password || !toggle) {
            return;
        }

        toggle.addEventListener(
            "click",
            function () {

                const isVisible =
                    password.type === "text";

                password.type =
                    isVisible
                        ? "password"
                        : "text";

                toggle.setAttribute(
                    "aria-label",
                    isVisible
                        ? "Show password"
                        : "Hide password"
                );

                toggle.setAttribute(
                    "aria-pressed",
                    isVisible
                        ? "false"
                        : "true"
                );

            }
        );

    }
);
</script>

</body>

</html>
